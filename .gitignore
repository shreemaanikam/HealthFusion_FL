# =====================================================
# HealthFusion_FL - Git Ignore
# =====================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.production
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Model artifacts (large binary files)
*.pkl
*.joblib
*.h5
*.keras
*.pb
models/tensorflow/checkpoints/
models/tensorflow/saved_model/

# Data files (download separately — see docs/data_setup.md)
data/raw/*.csv
data/processed/*.csv
data/federated/*.csv

# Keep directory structure
!**/.gitkeep

# Database
*.db
*.sqlite3

# Logs
logs/
*.log

# Docker
docker-compose.override.yml

# Coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Screenshots (generated)
screenshots/*.png

# Reports with large data
reports/tensorflow_training_history.csv
