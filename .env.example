# =====================================================
# HealthFusion_FL - Environment Configuration
# =====================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =====================================================

# ----- Application -----
APP_NAME=HealthFusion_FL
APP_ENV=development
DEMO_MODE=true
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ----- Database -----
# SQLite (development default)
DATABASE_URL=sqlite:///./healthfusion.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/healthfusion

# ----- Authentication -----
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- OpenRouter (optional - Phase 12) -----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----- Federated Learning -----
FEDERATION_MODE=iid
FL_NUM_ROUNDS=5
FL_MIN_CLIENTS=3
FL_SERVER_ADDRESS=0.0.0.0:8080

# ----- Privacy -----
DP_ENABLED=false
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_NOISE_MULTIPLIER=1.1
DP_MAX_GRAD_NORM=1.0

# ----- Model -----
MODEL_RANDOM_SEED=42
MODEL_BATCH_SIZE=64
MODEL_EPOCHS=100
MODEL_LEARNING_RATE=0.001

# ----- Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
