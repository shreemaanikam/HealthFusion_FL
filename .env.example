# =====================================================
# HealthFusion_FL - Backend Environment Template
# =====================================================
# Copy to .env for local development. In production, set these in the
# hosting dashboard (Render). NEVER commit real values.
# =====================================================

# ----- Application -----
APP_NAME=HealthFusion_FL
APP_ENV=development            # development | production
DEMO_MODE=false
DEBUG=true                     # must be false in production
SECRET_KEY=

# ----- Database -----
# Development (SQLite):
DATABASE_URL=sqlite:///./healthfusion.db
# Production (PostgreSQL; postgres:// and postgresql:// are auto-converted):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ----- Authentication -----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- CORS -----
# Comma-separated allowed browser origins. Production: the real HTTPS frontend only.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- OpenRouter (optional, server-side only) -----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----- Federated Learning (simulation) -----
FEDERATION_MODE=iid
FL_NUM_ROUNDS=5
FL_MIN_CLIENTS=3

# ----- Privacy (simulation) -----
DP_ENABLED=false
DP_EPSILON=1.0
DP_DELTA=1e-5

# ----- Server -----
LOG_LEVEL=INFO
