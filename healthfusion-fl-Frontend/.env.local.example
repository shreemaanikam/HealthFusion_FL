# Copy to .env.local for local development, or set these in the Vercel dashboard.
# Only NEXT_PUBLIC_* values are exposed to the browser -- never put secrets here.

# true  = built-in demo datasets, no backend required (clearly bannered in the UI)
# false = live mode, all data from the backend API
NEXT_PUBLIC_DEMO_MODE=false

# Public HTTPS URL of the deployed backend (no trailing slash).
# Local development: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
