# When true, the app runs entirely on the typed demo datasets in /data/demo
# and every /services/api/* function short-circuits to demo data.
# When false, the same functions call NEXT_PUBLIC_API_BASE_URL instead.
# The UI never mixes the two silently -- see DemoBanner + lib/demo-mode.ts.
NEXT_PUBLIC_DEMO_MODE=true

# Base URL of the HealthFusion_FL backend (FastAPI/Flask service).
# Unused while NEXT_PUBLIC_DEMO_MODE=true.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
